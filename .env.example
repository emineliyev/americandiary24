# Copy to .env and fill in real values. Never commit the real .env.
#
# Local dev: the defaults below already work as-is.
# Production (VPS): every value in this file must change — see the
# comment on each one.

# Production: must be False. DEBUG=True leaks stack traces/source to visitors.
DEBUG=True

# Production: generate a fresh key, don't reuse the dev one.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Production: the real domain(s) the VPS answers to, e.g. www.americandiary24.com,americandiary24.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Production: the real PostgreSQL credentials set up on the VPS.
DB_NAME=americandiary24
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Used for canonical URLs, sitemap.xml, ads.txt, CSRF_TRUSTED_ORIGINS — keep
# this the real https:// production domain even in dev (nothing dev-specific
# reads it as a literal host to bind to).
SITE_DOMAIN=https://www.americandiary24.com
SHOW_ADS=True

# Production: point at the VPS's own Redis instance (usually unchanged if
# Redis runs on the same VPS as Django).
REDIS_URL=redis://127.0.0.1:6379/1
